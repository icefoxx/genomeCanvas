# oauth2-proxy for GenomeCanvas Studio (copy to oauth2-proxy.cfg). Works with any OIDC provider:
# Microsoft Entra ID / Azure AD, Google Workspace, Okta, Keycloak, InCommon via CILogon, ...
http_address = "0.0.0.0:4180"
reverse_proxy = true
provider = "oidc"
oidc_issuer_url = "https://login.microsoftonline.com/<tenant-id>/v2.0"
client_id = "<client id>"
client_secret = "<client secret>"
redirect_url = "https://figures.core.example.edu/oauth2/callback"
cookie_secret = "<32 random bytes, base64: python3 -c 'import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())'>"
cookie_secure = true
email_domains = ["*"]          # restrict, e.g. ["uni.edu"], if only one institution should sign in
set_xauthrequest = true        # emits X-Auth-Request-Email / -User for nginx auth_request_set
upstreams = ["static://202"]
skip_provider_button = true
